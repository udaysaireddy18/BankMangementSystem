# Supabase project settings -> Project Settings -> API
# URL     : the "Project URL"          e.g. https://abcdefgh.supabase.co
# key     : the "anon"/"publishable" public key (safe to use in a browser)
SUPABASE_URL=YOUR-SUPABASE-PROJECT-URL
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLISHABLE-KEY

# Port the backend server listens on
PORT=5000